    ul { margin: 15px 0 20px 20px; color: #bbb; }
    li { margin-bottom: 8px; font-size: 14px; }
    .contact-box { background: #1a1a1e; border: 1px solid #333; padding: 15px; border-radius: 6px; margin-top: 20px; }
    .contact-box a { color: #e50914; font-weight: bold; text-decoration: none; }
    .contact-box a:hover { text-decoration: underline; }

    footer { background: #101012; border-top: 1px solid #202025; text-align: center; padding: 20px; color: #666; font-size: 13px; margin-top: auto; }
