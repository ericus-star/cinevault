<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DMCA Disclaimer - ERIVOX</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', system-ui, sans-serif; }
    body { background-color: #0d0d0f; color: #ffffff; min-height: 100vh; display: flex; flex-direction: column; user-select: none; }
    
    header { 
      background: #141417; 
      border-bottom: 2px solid #e50914; 
      padding: 20px 40px; 
      display: flex; 
      justify-content: space-between; 
      align-items: center; 
    }
    .logo { font-size: 32px; font-weight: 900; letter-spacing: 2px; color: #ffffff; text-decoration: none; }
    .logo span { color: #e50914; }
    .nav-link { color: #e50914; text-decoration: none; font-weight: bold; font-size: 15px; }
    .nav-link:hover { text-decoration: underline; }

    .container { max-width: 900px; width: 100%; margin: 40px auto; padding: 0 25px; flex-grow: 1; }
    .card { background: #151518; border: 1px solid #24242a; border-radius: 10px; padding: 35px; line-height: 1.7; }
    h1 { font-size: 28px; margin-bottom: 20px; border-bottom: 1px solid #333; padding-bottom: 12px; color: #ffffff; }
    p { color: #ccc; margin-bottom: 18px; font-size: 15px; }

    .contact-box {
      margin-top: 25px;
      padding: 18px 20px;
      background: #1c1c22;
      border-left: 4px solid #e50914;
      border-radius: 6px;
    }
    .contact-box strong { color: #ffffff; }
    .contact-box a { color: #e50914; text-decoration: none; font-weight: bold; }
    .contact-box a:hover { text-decoration: underline; }

    footer { background: #101012; border-top: 1px solid #202025; text-align: center; padding: 25px; color: #666; font-size: 13px; margin-top: auto; }
  </style>
</head>
<body>

  <header>
    <a href="/" class="logo">ERI<span>VOX</span></a>
    <a href="/" class="nav-link">← Return to Home</a>
  </header>

  <div class="container">
    <div class="card">
      <h1>DMCA Disclaimer</h1>
      <p>ERIVOX does not store, host, or stream media files on its own servers. All content and links provided on this site are indexed from third-party services and publicly accessible file hosting platforms.</p>
      <p>If you believe that any content linked on our platform infringes upon your copyright, please contact the third-party file hosting providers directly to request removal.</p>
      <p>For any legitimate copyright inquiries or takedown notices regarding links displayed on this site, please send a detailed request with proof of ownership to our contact address below.</p>

      <div class="contact-box">
        <strong>Administrative Contact Email:</strong> 
        <a href="mailto:eric.us0053@gmail.com">eric.us0053@gmail.com</a>
      </div>
    </div>
  </div>

  <footer>
    &copy; <%= new Date().getFullYear() %> ERIVOX. All rights reserved.
  </footer>

  <!-- FRONTEND PROTECTION: BLOCK DEVTOOLS & INSPECT SHORTCUTS -->
  <script>
    document.addEventListener('contextmenu', e => e.preventDefault());
    document.addEventListener('keydown', e => {
      if (
        e.key === 'F12' || 
        (e.ctrlKey && e.shiftKey && (e.key === 'I' || e.key === 'J' || e.key === 'C')) || 
        (e.ctrlKey && e.key === 'u')
      ) {
        e.preventDefault();
      }
    });
  </script>

</body>
</html>