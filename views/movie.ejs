<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= movie.title %> (<%= movie.releaseYear %>) - ERIVOX</title>
  
  <style>
    body {
      background-color: #0f172a;
      color: #f8fafc;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      margin: 0;
      padding: 20px;
    }

    .container {
      max-width: 900px;
      margin: 0 auto;
    }

    /* Responsive Iframe Player Container */
    .player-wrapper {
      position: relative;
      padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
      height: 0;
      overflow: hidden;
      border-radius: 12px;
      background: #000;
      box-shadow: 0 10px 25px rgba(0,0,0,0.5);
      margin-bottom: 25px;
    }

    .player-wrapper iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }

    .source-selector {
      margin-bottom: 20px;
      display: flex;
      gap: 10px;
    }

    .source-btn {
      background: #334155;
      color: #fff;
      border: none;
      padding: 8px 16px;
      border-radius: 6px;
      cursor: pointer;
      font-weight: 600;
      transition: background 0.2s;
    }

    .source-btn:hover, .source-btn.active {
      background: #2563eb;
    }

    .details-box {
      background: #1e293b;
      padding: 20px;
      border-radius: 12px;
      margin-bottom: 25px;
    }

    .download-section {
      background: #1e293b;
      padding: 20px;
      border-radius: 12px;
    }

    .btn-group {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 15px;
    }

    .download-btn {
      display: inline-flex;
      align-items: center;
      padding: 12px 20px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: bold;
      color: #ffffff;
      background-color: #3b82f6;
      transition: transform 0.2s, background-color 0.2s;
    }

    .download-btn:hover {
      background-color: #2563eb;
      transform: translateY(-2px);
    }

    .download-btn.gofile {
      background-color: #10b981;
    }

    .download-btn.gofile:hover {
      background-color: #059669;
    }
  </style>
</head>
<body>

<div class="container">
  <h1><%= movie.title %> (<%= movie.releaseYear %>)</h1>
  <p>⭐ Rating: <%= movie.voteAverage %>/10</p>

  <!-- Player Server Selector -->
  <div class="source-selector">
    <button class="source-btn active" onclick="switchServer('<%= movie.embedPrimary %>', this)">Server 1 (VidSrc)</button>
    <button class="source-btn" onclick="switchServer('<%= movie.embedSecondary %>', this)">Server 2 (AutoEmbed)</button>
  </div>

  <!-- Video Player -->
  <div class="player-wrapper">
    <iframe id="videoPlayer" src="<%= movie.embedPrimary %>" allowfullscreen="true"></iframe>
  </div>

  <!-- Movie Overview -->
  <div class="details-box">
    <h3>Overview</h3>
    <p><%= movie.overview %></p>
  </div>

  <!-- Download Section -->
  <div class="download-section">
    <h3>Download Links</h3>
    <p style="color: #94a3b8; font-size: 0.9em;">Stream providers have download options inside the player window, or use direct links below:</p>
    
    <div class="btn-group">
      <!-- Option A: Custom Gofile Link (Only shows if you added it in Admin) -->
      <% if (movie.customDownloadUrl) { %>
        <a href="<%= movie.customDownloadUrl %>" target="_blank" class="download-btn gofile">
          ⚡ Direct Gofile Download (<%= movie.quality || '720p' %> - <%= movie.fileSize || 'HD' %>)
        </a>
      <% } %>

      <!-- Option B: Embedded Stream/Download Server Links -->
      <a href="<%= movie.embedPrimary %>" target="_blank" class="download-btn">
        📥 Open Server 1 Player / Download
      </a>
      <a href="<%= movie.embedSecondary %>" target="_blank" class="download-btn">
        📥 Open Server 2 Player / Download
      </a>
    </div>
  </div>
</div>

<script>
  // Script to switch server source on button click
  function switchServer(url, element) {
    document.getElementById('videoPlayer').src = url;
    const buttons = document.querySelectorAll('.source-btn');
    buttons.forEach(btn => btn.classList.remove('active'));
    element.classList.add('active');
  }
</script>

</body>
</html>