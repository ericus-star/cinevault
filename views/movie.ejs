<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= item.title %> - ERIVOX</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    .media-details {
      display: flex;
      gap: 40px;
      margin-top: 30px;
      flex-wrap: wrap;
    }
    .media-poster img {
      width: 280px;
      border-radius: 8px;
      border: 1px solid #333;
    }
    .media-info {
      flex: 1;
      min-width: 300px;
    }
    .episode-list {
      margin-top: 25px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .episode-card {
      background: #181818;
      border: 1px solid #282828;
      padding: 15px 20px;
      border-radius: 6px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .btn-zip {
      display: inline-block;
      padding: 14px 25px;
      background: #e50914;
      color: #fff;
      font-weight: bold;
      border-radius: 6px;
      text-decoration: none;
      margin-bottom: 20px;
    }
    .btn-ep-download {
      padding: 8px 16px;
      background: #2b2b2b;
      color: #fff;
      border: 1px solid #444;
      border-radius: 4px;
      text-decoration: none;
      font-weight: 600;
    }
    .btn-ep-download:hover {
      background: #e50914;
      border-color: #e50914;
    }
  </style>
</head>
<body>

  <header>
    <div class="logo">
      <a href="/"><span class="logo-white">ERI</span><span class="logo-red">VOX</span></a>
    </div>
    <nav class="top-nav">
      <a href="/">← Back to Collection</a>
    </nav>
  </header>

  <main class="container">
    <div class="media-details">
      <div class="media-poster">
        <img src="<%= item.poster || '/placeholder.jpg' %>" alt="<%= item.title %>">
      </div>
      <div class="media-info">
        <h1><%= item.title %></h1>
        <p style="color: #888; margin: 10px 0 20px;"><%= item.genre %> | <span style="text-transform: uppercase;"><%= item.type %></span></p>

        <!-- Main Full Season ZIP / Direct Movie Download -->
        <% if (item.videoUrl) { %>
          <a href="<%= item.videoUrl %>" download target="_blank" rel="noopener noreferrer" class="btn-zip">
            📦 Download <%= item.type === 'tv' ? 'Full Season (ZIP)' : 'Full Movie' %>
          </a>
        <% } %>

        <!-- Individual Episodes (If Any Exist) -->
        <% if (item.episodes && item.episodes.length > 0) { %>
          <h3 style="margin-top: 20px; border-bottom: 1px solid #333; padding-bottom: 10px;">Individual Episodes</h3>
          <div class="episode-list">
            <% item.episodes.forEach(ep => { %>
              <div class="episode-card">
                <span><strong><%= ep.title %></strong></span>
                <a href="<%= ep.videoUrl %>" download target="_blank" rel="noopener noreferrer" class="btn-ep-download">
                  Download Episode
                </a>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </main>

  <footer>
    <div class="footer-container">
      <p>&copy; <%= new Date().getFullYear() %> ERIVOX. All rights reserved.</p>
    </div>
  </footer>

</body>
</html>