<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= movie.title %> - ERIVOX</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        body { background-color: #0f172a; color: #f8fafc; min-height: 100vh; padding: 2rem 1rem; }
        .container { max-width: 900px; margin: 0 auto; }
        header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
        .logo { font-size: 1.5rem; font-weight: 800; color: #38bdf8; text-decoration: none; }
        .back-btn { color: #94a3b8; text-decoration: none; font-size: 0.95rem; }
        .back-btn:hover { color: #fff; }
        
        .server-selector { display: flex; gap: 10px; margin-bottom: 1rem; flex-wrap: wrap; }
        .server-btn { padding: 0.6rem 1.2rem; background: #1e293b; color: #94a3b8; border: 1px solid #334155; border-radius: 8px; cursor: pointer; font-weight: 600; }
        .server-btn.active { background: #0284c7; color: white; border-color: #0284c7; }

        .player-wrapper { position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 12px; background: #000; border: 1px solid #334155; margin-bottom: 1.5rem; }
        .player-wrapper iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0; }

        .download-box { background: #1e293b; padding: 1.5rem; border-radius: 12px; border: 1px solid #334155; margin-bottom: 1.5rem; }
        .download-box h3 { font-size: 1.2rem; margin-bottom: 1rem; color: #38bdf8; display: flex; align-items: center; gap: 8px; }
        .download-buttons { display: flex; gap: 12px; flex-wrap: wrap; }
        .download-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 0.8rem 1.5rem; background: #10b981; color: white; text-decoration: none; font-weight: 700; border-radius: 8px; transition: background 0.2s; }
        .download-btn:hover { background: #059669; }
        .download-btn.secondary { background: #0284c7; }
        .download-btn.secondary:hover { background: #0369a1; }
        .meta-tag { display: inline-block; background: #334155; color: #cbd5e1; padding: 0.2rem 0.6rem; border-radius: 4px; font-size: 0.85rem; margin-left: 8px; }

        .movie-details h1 { font-size: 2rem; margin-bottom: 0.5rem; }
        .movie-meta { color: #94a3b8; margin-bottom: 1rem; font-size: 0.95rem; }
        .overview { color: #cbd5e1; line-height: 1.6; }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <a href="/" class="logo">ERIVOX</a>
            <a href="/" class="back-btn">← Back to Home</a>
        </header>

        <!-- Server Selector -->
        <div class="server-selector">
            <button class="server-btn active" onclick="switchServer('<%= movie.embedPrimary %>', this)">Server 1 (VidSrc)</button>
            <button class="server-btn" onclick="switchServer('<%= movie.embedSecondary %>', this)">Server 2 (AutoEmbed)</button>
            <button class="server-btn" onclick="switchServer('<%= movie.embedTertiary %>', this)">Server 3 (SmashyStream)</button>
        </div>

        <!-- Video Player Frame -->
        <div class="player-wrapper">
            <iframe id="video-player" src="<%= movie.embedPrimary %>" allowfullscreen allow="autoplay; encrypted-media"></iframe>
        </div>

        <!-- Direct Download Section -->
        <div class="download-box">
            <h3>📥 Download Options</h3>
            <% if (movie.customDownloadUrl) { %>
                <p style="margin-bottom: 1rem; color: #94a3b8;">High-speed Gofile direct download link available:</p>
                <a href="<%= movie.customDownloadUrl %>" target="_blank" rel="noopener noreferrer" class="download-btn">
                    Download Movie
                    <% if (movie.quality) { %><span class="meta-tag"><%= movie.quality %></span><% } %>
                    <% if (movie.fileSize) { %><span class="meta-tag"><%= movie.fileSize %></span><% } %>
                </a>
            <% } else { %>
                <p style="margin-bottom: 1rem; color: #94a3b8;">Direct download mirrors for this title:</p>
                <div class="download-buttons">
                    <a href="https://dl.vidsrc.vip/movie/<%= movie.tmdbId %>" target="_blank" rel="noopener noreferrer" class="download-btn">
                        Download Link 1
                    </a>
                    <a href="https://vidsrc.icu/embed/movie/<%= movie.tmdbId %>" target="_blank" rel="noopener noreferrer" class="download-btn secondary">
                        Download Link 2
                    </a>
                </div>
            <% } %>
        </div>

        <!-- Movie Details -->
        <div class="movie-details">
            <h1><%= movie.title %></h1>
            <div class="movie-meta">
                <span><%= movie.releaseYear %></span> • <span>★ <%= movie.voteAverage %></span>
            </div>
            <p class="overview"><%= movie.overview %></p>
        </div>
    </div>

    <script>
        function switchServer(url, btn) {
            document.getElementById('video-player').src = url;
            document.querySelectorAll('.server-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
        }
    </script>
</body>
</html>