<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ERIVOX - Admin Dashboard</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', sans-serif; }
    body { background-color: #0b0b0b; color: #ffffff; min-height: 100vh; padding: 20px; }
    .admin-container { max-width: 600px; margin: 40px auto; background: #141414; padding: 30px; border-radius: 8px; border: 1px solid #282828; }
    h2 { font-size: 24px; margin-bottom: 20px; color: #ffffff; }
    h2 span { color: #e50914; }
    .form-group { margin-bottom: 15px; }
    label { display: block; margin-bottom: 5px; font-weight: 600; font-size: 14px; color: #b3b3b3; }
    input, select, textarea { width: 100%; padding: 12px; background: #222; border: 1px solid #333; color: #fff; border-radius: 4px; font-size: 14px; }
    textarea { height: 80px; resize: vertical; }
    .btn-autofetch { background: #333; color: white; border: 1px solid #444; padding: 10px; border-radius: 4px; cursor: pointer; margin-top: 5px; font-weight: bold; width: 100%; }
    .btn-autofetch:hover { background: #444; }
    .btn-publish { background: #e50914; color: white; border: none; padding: 12px; border-radius: 4px; cursor: pointer; font-weight: bold; width: 100%; font-size: 16px; margin-top: 15px; }
    .btn-publish:hover { background: #b80710; }
    .header-nav { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; border-bottom: 1px solid #282828; padding-bottom: 15px; }
    .header-nav a { color: #e50914; text-decoration: none; font-weight: bold; }
  </style>
</head>
<body>

  <div class="admin-container">
    <div class="header-nav">
      <h2>ERI<span>VOX</span> Admin</h2>
      <a href="/">← Go to Site</a>
    </div>

    <!-- AUTO-FETCH SECTION -->
    <div style="background: #181818; padding: 15px; border-radius: 6px; margin-bottom: 25px; border: 1px solid #222;">
      <div class="form-group">
        <label>Search TMDB Title</label>
        <input type="text" id="fetchTitle" placeholder="e.g. Agent Kim, Breaking Bad">
      </div>
      <div class="form-group">
        <label>Type</label>
        <select id="fetchType">
          <option value="movie">Movie</option>
          <option value="tv">TV Show</option>
        </select>
      </div>
      <button type="button" class="btn-autofetch" onclick="autoFetch()">Auto-Fetch Info</button>
      <span id="fetchStatus" style="font-size: 12px; margin-top: 5px; display: block;"></span>
    </div>

    <!-- PUBLISH FORM -->
    <form action="/admin/add" method="POST">
      <div class="form-group">
        <label>Media Type</label>
        <select name="type" id="typeSelect">
          <option value="movie">Movie</option>
          <option value="tv">TV Show</option>
        </select>
      </div>

      <div class="form-group">
        <label>Title</label>
        <input type="text" name="title" id="title" required>
      </div>

      <div class="form-group">
        <label>TMDB ID</label>
        <input type="text" name="tmdbId" id="tmdbId">
      </div>

      <div class="form-group">
        <label>Genre</label>
        <input type="text" name="genre" id="genre">
      </div>

      <div class="form-group">
        <label>Poster Image URL</label>
        <input type="text" name="posterUrl" id="posterUrl">
      </div>

      <div class="form-group">
        <label>Overview</label>
        <textarea name="overview" id="overview"></textarea>
      </div>

      <div class="form-group">
        <label>Gofile / Video Download Link</label>
        <input type="text" name="gofileUrl" placeholder="https://gofile.io/d/..." required>
      </div>

      <div class="form-group">
        <label>Subtitle Download Link (Optional)</label>
        <input type="text" name="subtitleUrl" placeholder="https://gofile.io/d/... or .srt/.vtt link">
      </div>

      <button type="submit" class="btn-publish">Publish to ERIVOX</button>
    </form>
  </div>

  <script>
    async function autoFetch() {
      const title = document.getElementById('fetchTitle').value;
      const type = document.getElementById('fetchType').value;
      const status = document.getElementById('fetchStatus');

      if (!title) {
        status.style.color = 'red';
        status.innerText = 'Please enter a title to search.';
        return;
      }

      status.style.color = '#aaa';
      status.innerText = 'Fetching...';

      try {
        const res = await fetch(`/admin/autofetch?title=${encodeURIComponent(title)}&type=${type}`);
        const data = await res.json();

        if (res.ok) {
          document.getElementById('title').value = data.title || '';
          document.getElementById('tmdbId').value = data.tmdbId || '';
          document.getElementById('genre').value = data.genres || '';
          document.getElementById('posterUrl').value = data.posterPath || '';
          document.getElementById('overview').value = data.overview || '';
          document.getElementById('typeSelect').value = type;

          status.style.color = '#00ff66';
          status.innerText = 'Details fetched successfully!';
        } else {
          status.style.color = 'red';
          status.innerText = data.error || 'Failed to fetch details.';
        }
      } catch (err) {
        status.style.color = 'red';
        status.innerText = 'Error connecting to server.';
      }
    }
  </script>

</body>
</html>