<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Erivox Admin Panel</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <header>
    <div class="logo">Erivox Admin</div>
    <nav>
      <a href="/">View Site</a>
      <a href="/logout">Logout</a>
    </nav>
  </header>

  <main class="container">
    <h2>Add New Movie</h2>
    
    <form action="/admin/add" method="POST" class="admin-form">
      <div class="form-group">
        <label for="title">Movie Title</label>
        <input type="text" id="title" name="title" placeholder="e.g. Deadpool & Wolverine" required>
      </div>

      <div class="form-group">
        <label for="genre">Genre</label>
        <input type="text" id="genre" name="genre" placeholder="e.g. Action, Sci-Fi" required>
      </div>

      <div class="form-group">
        <label for="poster">Poster URL</label>
        <input type="url" id="poster" name="poster" placeholder="https://image.tmdb.org/t/p/w500/..." required>
      </div>

      <div class="form-group">
        <label for="videoUrl">Video / Storage Link</label>
        <input type="url" id="videoUrl" name="videoUrl" placeholder="https://pub-....r2.dev/movies/file.mp4" required>
      </div>

      <button type="submit" class="btn-submit">Add Movie</button>
    </form>

    <hr style="margin: 30px 0; border: 1px solid #333;">

    <h2>Manage Existing Movies</h2>
    <div class="admin-movie-list">
      <% if (movies && movies.length > 0) { %>
        <table class="admin-table">
          <thead>
            <tr>
              <th>Poster</th>
              <th>Title</th>
              <th>Genre</th>
              <th>Video Link</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% movies.forEach(movie => { %>
              <tr>
                <td><img src="<%= movie.poster %>" alt="<%= movie.title %>" style="width: 50px; height: 75px; object-fit: cover;"></td>
                <td><%= movie.title %></td>
                <td><%= movie.genre %></td>
                <td><a href="<%= movie.videoUrl %>" target="_blank">View Link</a></td>
                <td>
                  <form action="/admin/delete/<%= movie._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this movie?');">
                    <button type="submit" class="btn-delete">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <p>No movies in database yet.</p>
      <% } %>
    </div>
  </main>

</body>
</html>