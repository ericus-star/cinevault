<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ERIVOX - Admin Panel</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .admin-container {
      max-width: 800px;
      margin: 40px auto;
      padding: 20px;
      background: #1e1e1e;
      color: #fff;
      border-radius: 8px;
    }
    .form-group {
      margin-bottom: 20px;
      display: flex;
      flex-direction: column;
    }
    .form-group label {
      margin-bottom: 8px;
      font-weight: bold;
    }
    .form-group input, .form-group select, .form-group textarea {
      padding: 10px;
      border-radius: 4px;
      border: 1px solid #444;
      background: #2b2b2b;
      color: #fff;
    }
    .fetch-row {
      display: flex;
      gap: 10px;
    }
    .fetch-row input {
      flex: 1;
    }
    .btn-fetch {
      padding: 10px 16px;
      background: #e50914;
      color: white;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-weight: bold;
    }
    .btn-fetch:hover {
      background: #b80710;
    }
    .btn-submit {
      padding: 12px;
      background: #28a745;
      color: white;
      border: none;
      border-radius: 4px;
      font-size: 16px;
      cursor: pointer;
      font-weight: bold;
    }
    .btn-submit:hover {
      background: #218838;
    }
  </style>
</head>
<body>

  <%- include('partials/navbar') %>

  <div class="admin-container">
    <h2>ERIVOX Content Manager</h2>
    <form action="/admin/add" method="POST">
      
      <!-- TITLE & AUTO FETCH ROW -->
      <div class="form-group">
        <label for="fetchTitle">Search Title</label>
        <div class="fetch-row">
          <input type="text" id="fetchTitle" name="title" placeholder="Enter title (e.g. Agent Kim)" required>
          <select id="fetchType">
            <option value="movie">Movie</option>
            <option value="tv">TV Show</option>
          </select>
          <button type="button" class="btn-fetch" onclick="autoFetchFromTMDB()">Auto-Fetch ID</button>
        </div>
      </div>

      <!-- AUTO-FILLED FIELDS -->
      <div class="form-group">
        <label for="tmdbIdInput">TMDB ID</label>
        <input type="text" name="tmdbId" id="tmdbIdInput" placeholder="Auto-generated TMDB ID" readonly required>
      </div>

      <div class="form-group">
        <label for="posterUrlInput">Poster URL</label>
        <input type="text" name="posterUrl" id="posterUrlInput" placeholder="Auto-generated Poster URL">
      </div>

      <div class="form-group">
        <label for="overviewInput">Overview / Description</label>
        <textarea name="overview" id="overviewInput" rows="5" placeholder="Auto-generated Overview"></textarea>
      </div>

      <!-- GOFILE DOWNLOAD LINK FIELD -->
      <div class="form-group">
        <label for="gofileUrl">Gofile Link</label>
        <input type="text" name="gofileUrl" id="gofileUrl" placeholder="Paste Gofile link (e.g. https://gofile.io/d/XXXXXX)" required>
      </div>

      <button type="submit" class="btn-submit">Save Content to ERIVOX</button>
    </form>
  </div>

  <script>
  async function autoFetchFromTMDB() {
    const titleInput = document.getElementById('fetchTitle').value.trim();
    const typeSelect = document.getElementById('fetchType').value;

    if (!titleInput) {
      alert('Please type a title first!');
      return;
    }

    try {
      const response = await fetch(`/admin/autofetch?title=${encodeURIComponent(titleInput)}&type=${typeSelect}`);
      const data = await response.json();

      if (response.ok) {
        document.getElementById('tmdbIdInput').value = data.tmdbId;
        document.getElementById('posterUrlInput').value = data.posterPath;
        document.getElementById('overviewInput').value = data.overview;
        alert(`Successfully fetched details for: ${data.title}`);
      } else {
        alert(data.error || 'Content not found on TMDB');
      }
    } catch (err) {
      console.error(err);
      alert('Failed to connect to server. Check your connection or backend logs.');
    }
  }
  </script>

</body>
</html>