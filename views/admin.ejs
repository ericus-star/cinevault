<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Erivox Admin Panel</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    body {
      background-color: #0d0d0d;
      color: #ffffff;
    }

    .admin-container {
      max-width: 950px;
      margin: 40px auto;
      padding: 0 20px;
    }

    .admin-card {
      background-color: #141414;
      border: 1px solid #222;
      border-radius: 8px;
      padding: 30px;
      margin-bottom: 40px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.5);
    }

    /* Form Styling */
    .form-group {
      margin-bottom: 20px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .form-group label {
      font-weight: 600;
      font-size: 0.95rem;
      color: #ccc;
    }

    .form-input, .form-select {
      width: 100%;
      padding: 12px 15px;
      background: #1a1a1a;
      color: #ffffff;
      border: 1px solid #333;
      border-radius: 6px;
      font-size: 1rem;
      outline: none;
      transition: border-color 0.2s ease;
    }

    .form-input:focus, .form-select:focus {
      border-color: #e50914;
    }

    .input-with-btn {
      display: flex;
      gap: 10px;
    }

    .btn-fetch {
      padding: 12px 20px;
      background-color: #e50914;
      color: #ffffff;
      border: none;
      border-radius: 6px;
      font-weight: bold;
      cursor: pointer;
      white-space: nowrap;
      transition: background 0.2s ease;
    }

    .btn-fetch:hover {
      background-color: #f40612;
    }

    .btn-submit {
      width: 100%;
      padding: 14px;
      background-color: #e50914;
      color: #ffffff;
      border: none;
      border-radius: 6px;
      font-size: 1.1rem;
      font-weight: bold;
      cursor: pointer;
      margin-top: 10px;
      transition: background 0.2s ease;
    }

    .btn-submit:hover {
      background-color: #f40612;
    }

    /* Admin Table Styling */
    .media-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
      background: #141414;
      border-radius: 8px;
      overflow: hidden;
      border: 1px solid #222;
    }

    .media-table th, .media-table td {
      padding: 15px;
      text-align: left;
      border-bottom: 1px solid #222;
      vertical-align: top;
    }

    .media-table th {
      background-color: #1a1a1a;
      color: #e50914;
    }

    .btn-danger {
      background-color: #333;
      color: #ff4d4d;
      border: 1px solid #444;
      padding: 6px 12px;
      border-radius: 4px;
      cursor: pointer;
      font-weight: bold;
    }

    .btn-danger:hover {
      background-color: #e50914;
      color: #fff;
    }

    /* Inline Add Episode Form */
    .add-ep-form {
      margin-top: 10px;
      padding-top: 10px;
      border-top: 1px dashed #333;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .ep-input-row {
      display: flex;
      gap: 6px;
    }

    .ep-input-row input {
      padding: 6px 10px;
      background: #1a1a1a;
      color: #fff;
      border: 1px solid #333;
      border-radius: 4px;
      font-size: 0.85rem;
    }

    .btn-add-ep {
      background: #e50914;
      color: #fff;
      border: none;
      padding: 6px 12px;
      border-radius: 4px;
      cursor: pointer;
      font-weight: bold;
      font-size: 0.85rem;
      white-space: nowrap;
    }
  </style>
</head>
<body>

  <header>
    <div class="logo">
      <a href="/"><span class="logo-white">ERI</span><span class="logo-red">VOX</span></a>
    </div>
    <nav class="top-nav">
      <a href="/">Home</a>
      <a href="/logout" style="color: #888;">Logout</a>
    </nav>
  </header>

  <main class="admin-container">
    
    <!-- Form to Add Title -->
    <div class="admin-card">
      <h2>Add New Movie / TV Show</h2>
      <br>

      <form action="/admin/add" method="POST">
        
        <!-- Title & TMDB Fetch -->
        <div class="form-group">
          <label for="title">Title</label>
          <div class="input-with-btn">
            <input type="text" id="title" name="title" class="form-input" placeholder="e.g. Shōgun or Deadpool & Wolverine" required>
            <button type="button" class="btn-fetch" onclick="fetchTMDB()">Auto-Fetch TMDB</button>
          </div>
        </div>

        <!-- Content Type -->
        <div class="form-group">
          <label for="type">Content Type</label>
          <select id="type" name="type" class="form-select">
            <option value="movie">Movie</option>
            <option value="tv">TV Show</option>
          </select>
        </div>

        <!-- Genre -->
        <div class="form-group">
          <label for="genre">Genre</label>
          <input type="text" id="genre" name="genre" class="form-input" placeholder="e.g. Action, Drama, Sci-Fi" required>
        </div>

        <!-- Poster URL -->
        <div class="form-group">
          <label for="poster">Poster URL</label>
          <input type="text" id="poster" name="poster" class="form-input" placeholder="https://image.tmdb.org/t/p/w500/..." required>
        </div>

        <!-- Video URL / Full Season ZIP -->
        <div class="form-group">
          <label for="videoUrl">Full Movie Link or Full Season (.ZIP) Link</label>
          <input type="text" id="videoUrl" name="videoUrl" class="form-input" placeholder="https://pub-....r2.dev/seasons/shogun/Shogun_Season_1.zip">
        </div>

        <button type="submit" class="btn-submit">Add Content</button>
      </form>
    </div>

    <!-- Existing Content List -->
    <div class="admin-card">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
        <h2>Existing Media (<%= movies.length %>)</h2>
        <% if (movies.length > 0) { %>
          <form action="/admin/delete-all" method="POST" onsubmit="return confirm('Delete ALL content from database?');">
            <button type="submit" class="btn-danger">Delete All</button>
          </form>
        <% } %>
      </div>

      <% if (movies && movies.length > 0) { %>
        <table class="media-table">
          <thead>
            <tr>
              <th>Poster</th>
              <th>Title</th>
              <th>Type</th>
              <th>Episodes</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% movies.forEach(movie => { %>
              <tr>
                <td>
                  <img src="<%= movie.poster %>" alt="<%= movie.title %>" style="width: 50px; height: 70px; object-fit: cover; border-radius: 4px;">
                </td>
                <td>
                  <strong><%= movie.title %></strong>
                  <br><small style="color: #888;"><%= movie.genre %></small>
                </td>
                <td style="text-transform: uppercase; font-size: 0.85rem; color: #888;"><%= movie.type %></td>
                <td>
                  <% if (movie.type === 'tv') { %>
                    <span style="font-size: 0.9rem; color: #ccc;">
                      <%= movie.episodes ? movie.episodes.length : 0 %> Episode(s) Added
                    </span>

                    <!-- Quick Add Individual Episode Form -->
                    <form action="/admin/add-episode/<%= movie._id %>" method="POST" class="add-ep-form">
                      <div class="ep-input-row">
                        <input type="text" name="episodeTitle" placeholder="e.g. Episode 1" required style="width: 100px;">
                        <input type="text" name="episodeUrl" placeholder="R2 Direct Video URL" required style="flex: 1;">
                      </div>
                      <button type="submit" class="btn-add-ep">+ Add Episode</button>
                    </form>
                  <% else { %>
                    <span style="color: #555;">N/A (Single Movie)</span>
                  <% } %>
                </td>
                <td>
                  <form action="/admin/delete/<%= movie._id %>" method="POST" onsubmit="return confirm('Delete this media item?');">
                    <button type="submit" class="btn-danger">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <p style="color: #888;">No items added yet.</p>
      <% } %>
    </div>

  </main>

  <script>
    async function fetchTMDB() {
      const titleInput = document.getElementById('title');
      const typeInput = document.getElementById('type');
      const posterInput = document.getElementById('poster');
      const query = titleInput.value.trim();

      if (!query) {
        alert('Please enter a title first!');
        return;
      }

      try {
        const response = await fetch(`/admin/fetch-tmdb?title=${encodeURIComponent(query)}&type=${typeInput.value}`);
        const data = await response.json();

        if (response.ok && data.poster) {
          posterInput.value = data.poster;
          if (data.title) titleInput.value = data.title;
        } else {
          alert(data.error || 'Title not found on TMDB');
        }
      } catch (err) {
        alert('Error fetching from TMDB: ' + err.message);
      }
    }
  </script>

</body>
</html>