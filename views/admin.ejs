<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ERIVOX Admin</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', system-ui, sans-serif; }
    body { background-color: #0d0d0f; color: #ffffff; padding: 40px 20px; }
    .header { max-width: 900px; margin: 0 auto 30px; display: flex; justify-content: space-between; align-items: center; }
    .header h1 { font-size: 28px; }
    .header h1 span { color: #e50914; }
    .header a { color: #e50914; text-decoration: none; font-weight: bold; }

    .card { background: #141417; border: 1px solid #24242a; border-radius: 8px; padding: 25px; max-width: 900px; margin: 0 auto 30px; }
    .card h2 { margin-bottom: 20px; font-size: 20px; border-bottom: 1px solid #222; padding-bottom: 10px; }
    
    .form-group { margin-bottom: 15px; }
    label { display: block; margin-bottom: 5px; font-size: 14px; color: #aaa; }
    input[type="text"], select { width: 100%; padding: 12px; background: #1a1a1e; border: 1px solid #333; color: #fff; border-radius: 6px; outline: none; }
    input:focus, select:focus { border-color: #e50914; }
    
    .btn { background: #e50914; color: white; border: none; padding: 12px 20px; border-radius: 6px; font-weight: bold; cursor: pointer; width: 100%; margin-top: 10px; }
    .btn:hover { background: #b80710; }
    .btn-secondary { background: #25252b; color: #fff; margin-bottom: 15px; }
    .btn-secondary:hover { background: #33333d; }
    
    #status-msg { font-size: 13px; margin-top: 8px; color: #ff4d4d; }

    .media-table { width: 100%; border-collapse: collapse; margin-top: 15px; }
    .media-table th, .media-table td { text-align: left; padding: 12px; border-bottom: 1px solid #222; font-size: 14px; }
    .media-table th { background: #1a1a1e; color: #888; }
    .btn-del { background: #ff4d4d; color: white; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer; font-size: 12px; }
  </style>
</head>
<body>

  <div class="header">
    <h1>ERI<span>VOX</span> Admin</h1>
    <div>
      <a href="/">← Go to Site</a> | 
      <a href="/logout" style="color:#888;">Logout</a>
    </div>
  </div>

  <!-- Auto Fetch Tool -->
  <div class="card">
    <h2>1. Auto-Fetch Movie/Show Details</h2>
    <div class="form-group">
      <label>Search Title</label>
      <input type="text" id="tmdb-query" placeholder="e.g. Avatar The Last Airbender">
    </div>
    <div class="form-group">
      <label>Type</label>
      <select id="tmdb-type">
        <option value="tv">TV Show</option>
        <option value="movie">Movie</option>
      </select>
    </div>
    <button type="button" onclick="fetchTMDB()" class="btn btn-secondary">Auto-Fetch Info</button>
    <div id="status-msg"></div>
  </div>

  <!-- Media Entry Form -->
  <div class="card">
    <h2>2. Save Entry</h2>
    <form action="/admin/add" method="POST">
      <div class="form-group">
        <label>Title</label>
        <input type="text" id="title" name="title" required placeholder="Title">
      </div>
      <div class="form-group">
        <label>Type</label>
        <select id="type" name="type">
          <option value="movie">Movie</option>
          <option value="tv">TV Show</option>
        </select>
      </div>
      <div class="form-group">
        <label>Genre</label>
        <input type="text" id="genre" name="genre" placeholder="Action, Drama, Sci-Fi">
      </div>
      <div class="form-group">
        <label>Poster Image URL</label>
        <input type="text" id="posterUrl" name="posterUrl" placeholder="https://image.tmdb.org/...">
      </div>
      <div class="form-group">
        <label>Gofile Download Link (Required)</label>
        <input type="text" name="gofileUrl" required placeholder="https://gofile.io/d/...">
      </div>
      <div class="form-group">
        <label>Subtitle Download Link (Optional)</label>
        <input type="text" name="subtitleUrl" placeholder="https://...">
      </div>
      <button type="submit" class="btn">Add Media Entry</button>
    </form>
  </div>

  <!-- Media List Table -->
  <div class="card">
    <h2>Existing Content (<%= typeof mediaList !== 'undefined' ? mediaList.length : 0 %>)</h2>
    <table class="media-table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Type</th>
          <th>Genre</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (typeof mediaList !== 'undefined' && mediaList.length > 0) { %>
          <% mediaList.forEach(item => { %>
            <tr>
              <td><%= item.title %></td>
              <td><%= item.type %></td>
              <td><%= item.genre || 'N/A' %></td>
              <td>
                <form action="/admin/delete/<%= item._id %>" method="POST" style="display:inline;">
                  <button type="submit" onclick="return confirm('Delete this?')" class="btn-del">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="4" style="color:#777;">No media entries added yet.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <script>
    async function fetchTMDB() {
      const query = document.getElementById('tmdb-query').value.trim();
      const type = document.getElementById('tmdb-type').value;
      const status = document.getElementById('status-msg');

      if (!query) {
        status.innerText = 'Please enter a title to search.';
        return;
      }

      status.style.color = '#ccc';
      status.innerText = 'Fetching info...';

      try {
        const res = await fetch(`/api/tmdb?title=${encodeURIComponent(query)}&type=${type}`);
        const data = await res.json();

        if (res.ok) {
          document.getElementById('title').value = data.title || '';
          document.getElementById('type').value = type;
          document.getElementById('genre').value = data.genre || '';
          document.getElementById('posterUrl').value = data.posterUrl || '';
          status.style.color = '#28a745';
          status.innerText = 'Successfully fetched metadata!';
        } else {
          status.style.color = '#ff4d4d';
          status.innerText = data.error || 'Could not find details.';
        }
      } catch (err) {
        status.style.color = '#ff4d4d';
        status.innerText = 'Error connecting to server route.';
      }
    }
  </script>
</body>
</html>