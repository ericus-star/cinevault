<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ERIVOX - Admin Panel</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', system-ui, sans-serif; }
    body { background-color: #0d0d0f; color: #ffffff; min-height: 100vh; display: flex; flex-direction: column; }
    
    header { background: #141417; border-bottom: 2px solid #e50914; padding: 20px 40px; display: flex; justify-content: space-between; align-items: center; }
    .logo { font-size: 28px; font-weight: 900; letter-spacing: 2px; color: #ffffff; text-decoration: none; }
    .logo span { color: #e50914; }
    .nav-links { display: flex; gap: 20px; align-items: center; }
    .nav-links a { color: #ccc; text-decoration: none; font-weight: bold; font-size: 14px; }
    .nav-links a:hover { color: #e50914; }

    .container { max-width: 900px; width: 100%; margin: 30px auto; padding: 0 20px; flex-grow: 1; }
    .card { background: #151518; border: 1px solid #24242a; border-radius: 10px; padding: 25px; margin-bottom: 25px; }
    h2 { font-size: 20px; margin-bottom: 18px; border-bottom: 1px solid #2a2a30; padding-bottom: 10px; color: #ffffff; }

    .form-group { margin-bottom: 15px; }
    label { display: block; font-size: 13px; font-weight: bold; margin-bottom: 6px; color: #aaa; text-transform: uppercase; }
    .input-field { width: 100%; background: #1a1a1e; border: 1px solid #333; color: #fff; padding: 10px 14px; border-radius: 6px; outline: none; font-size: 14px; }
    .input-field:focus { border-color: #e50914; }

    .btn { background: #e50914; color: #fff; border: none; padding: 12px 20px; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 14px; width: 100%; transition: background 0.2s; }
    .btn:hover { background: #b80710; }
    .btn-secondary { background: #222228; border: 1px solid #444; margin-bottom: 15px; }
    .btn-secondary:hover { background: #33333d; }

    .error-msg { color: #ff4d4d; font-size: 13px; font-weight: bold; margin-top: 10px; }
    .success-msg { color: #28a745; font-size: 13px; font-weight: bold; margin-top: 10px; }

    table { width: 100%; border-collapse: collapse; margin-top: 15px; }
    th, td { text-align: left; padding: 12px; border-bottom: 1px solid #222228; font-size: 14px; }
    th { color: #888; font-size: 12px; text-transform: uppercase; }
    .btn-edit-sm { background: #222228; color: #28a745; border: 1px solid #333; padding: 5px 10px; border-radius: 4px; text-decoration: none; font-size: 12px; font-weight: bold; margin-right: 5px; }
    .btn-edit-sm:hover { background: #28a745; color: #fff; }
    .btn-delete-sm { background: #1c1c22; color: #ff4d4d; border: 1px solid #333; padding: 5px 10px; border-radius: 4px; cursor: pointer; font-size: 12px; font-weight: bold; }
    .btn-delete-sm:hover { background: #ff4d4d; color: #fff; }

    footer { background: #101012; border-top: 1px solid #202025; text-align: center; padding: 20px; color: #666; font-size: 13px; margin-top: auto; }
  </style>
</head>
<body>

  <header>
    <a href="/" class="logo">ERI<span>VOX</span> Admin</a>
    <div class="nav-links">
      <a href="/">← Go to Site</a>
      <a href="/logout" style="color: #ff4d4d;">Logout</a>
    </div>
  </header>

  <div class="container">
    
    <!-- 1. AUTO FETCH -->
    <div class="card">
      <h2>1. Auto-Fetch Movie/Show Details</h2>
      <div class="form-group">
        <label for="fetchTitle">Search Title</label>
        <input type="text" id="fetchTitle" class="input-field" placeholder="e.g., A Shop for Killers">
      </div>
      
      <div class="form-group">
        <label for="fetchType">Type</label>
        <select id="fetchType" class="input-field">
          <option value="movie">Movie</option>
          <option value="tv">TV Show</option>
        </select>
      </div>

      <button type="button" class="btn btn-secondary" onclick="autoFetchInfo()">Auto-Fetch Info</button>
      <div id="fetchStatus" class="error-msg"></div>
    </div>

    <!-- 2. ADD ENTRY FORM -->
    <div class="card">
      <h2>2. Add Media Content</h2>
      <form action="/admin/add" method="POST">
        <div class="form-group">
          <label for="titleInput">Title</label>
          <input type="text" name="title" id="titleInput" class="input-field" required placeholder="Title">
        </div>

        <div class="form-group">
          <label for="typeInput">Type</label>
          <select name="type" id="typeInput" class="input-field" required>
            <option value="movie">Movie</option>
            <option value="tv">TV Show</option>
          </select>
        </div>

        <div class="form-group">
          <label for="genreInput">Genre</label>
          <input type="text" name="genre" id="genreInput" class="input-field" placeholder="Action, Thriller">
        </div>

        <div class="form-group">
          <label for="posterInput">Poster Image URL (TMDB or R2 Public Link)</label>
          <input type="text" name="posterUrl" id="posterInput" class="input-field" placeholder="https://pub-xxx.r2.dev/... or TMDB Link">
        </div>

        <div class="form-group">
          <label for="gofileUrl">Cloudflare R2 Video Stream/Download Link</label>
          <input type="url" name="gofileUrl" id="gofileUrl" class="input-field" required placeholder="https://pub-95c821bb75f44bb99682161e9ae0be50.r2.dev/movies/...">
        </div>

        <div class="form-group">
          <label for="subtitleUrl">Subtitle URL (Optional)</label>
          <input type="url" name="subtitleUrl" id="subtitleUrl" class="input-field" placeholder="https://...">
        </div>

        <button type="submit" class="btn">Publish Content</button>
      </form>
    </div>

    <!-- 3. LIBRARY TABLE WITH EDIT AND DELETE -->
    <div class="card">
      <h2>3. Existing Library Entries</h2>
      <% if (typeof mediaList !== 'undefined' && mediaList.length > 0) { %>
        <table>
          <thead>
            <tr>
              <th>Title</th>
              <th>Type</th>
              <th>Genre</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% mediaList.forEach(item => { %>
              <tr>
                <td><strong><%= item.title %></strong></td>
                <td><%= item.type === 'tv' ? 'TV Show' : 'Movie' %></td>
                <td><%= item.genre || 'N/A' %></td>
                <td>
                  <a href="/admin/edit/<%= item._id %>" class="btn-edit-sm">Edit</a>
                  <form action="/admin/delete/<%= item._id %>" method="POST" style="display:inline;">
                    <button type="submit" onclick="return confirm('Delete <%= item.title %>?')" class="btn-delete-sm">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <p style="color: #777;">No media uploads found in the database.</p>
      <% } %>
    </div>

  </div>

  <footer>
    &copy; <%= new Date().getFullYear() %> ERIVOX Management Console
  </footer>

  <script>
    async function autoFetchInfo() {
      const titleInput = document.getElementById('fetchTitle');
      const typeSelect = document.getElementById('fetchType');
      const statusDiv = document.getElementById('fetchStatus');

      const title = titleInput.value.trim();
      const rawType = typeSelect.value.toLowerCase();
      const type = rawType.includes('tv') ? 'tv' : 'movie';

      if (!title) {
        statusDiv.className = 'error-msg';
        statusDiv.innerText = 'Please enter a search title first.';
        return;
      }

      statusDiv.className = 'success-msg';
      statusDiv.innerText = 'Searching TMDB database...';

      try {
        const response = await fetch(`/api/tmdb?title=${encodeURIComponent(title)}&type=${type}`);
        if (!response.ok) throw new Error('No details found for this title.');

        const data = await response.json();
        if (data.error) throw new Error(data.error);

        document.getElementById('titleInput').value = data.title || title;
        document.getElementById('typeInput').value = type;
        document.getElementById('genreInput').value = data.genre || '';
        document.getElementById('posterInput').value = data.posterUrl || '';

        statusDiv.className = 'success-msg';
        statusDiv.innerText = 'Successfully fetched and populated details!';
      } catch (err) {
        console.error(err);
        statusDiv.className = 'error-msg';
        statusDiv.innerText = err.message || 'Error connecting to server route.';
      }
    }
  </script>

</body>
</html>