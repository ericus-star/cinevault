<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CINEVAULT Admin - Add Download Links</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="navbar">
    <div class="logo">
      <h1><a href="/" style="color:white; text-decoration:none;">CINE<span>VAULT</span></a></h1>
    </div>
  </header>

  <main style="max-width: 600px; margin: 40px auto; padding: 20px; background: #1f1f1f; border-radius: 8px;">
    <h2>➕ Add Download Links</h2>
    
    <% if (message) { %>
      <div style="background: #28a745; color: white; padding: 10px; margin-bottom: 20px; border-radius: 4px;">
        <%= message %>
      </div>
    <% } %>

    <form action="/admin/add-link" method="POST">
      <div style="margin-bottom: 15px;">
        <label style="display:block; margin-bottom: 5px;">TMDB Movie ID:</label>
        <input type="text" name="movieId" placeholder="e.g. 550" required style="width: 100%; padding: 10px; border-radius: 4px; border: none;">
      </div>

      <div style="margin-bottom: 15px;">
        <label style="display:block; margin-bottom: 5px;">Quality:</label>
        <input type="text" name="quality" placeholder="e.g. 720p WEBRip" required style="width: 100%; padding: 10px; border-radius: 4px; border: none;">
      </div>

      <div style="margin-bottom: 15px;">
        <label style="display:block; margin-bottom: 5px;">File Size:</label>
        <input type="text" name="size" placeholder="e.g. 850 MB" required style="width: 100%; padding: 10px; border-radius: 4px; border: none;">
      </div>

      <div style="margin-bottom: 20px;">
        <label style="display:block; margin-bottom: 5px;">Download URL:</label>
        <input type="url" name="url" placeholder="https://..." required style="width: 100%; padding: 10px; border-radius: 4px; border: none;">
      </div>

      <button type="submit" style="background: #e50914; color: white; border: none; padding: 12px 20px; font-weight: bold; border-radius: 4px; cursor: pointer;">
        Save Download Link
      </button>
    </form>
  </main>
</body>
</html>