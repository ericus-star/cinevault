<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ERIVOX - Details</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', sans-serif; }
    body { background-color: #0b0b0b; color: #ffffff; min-height: 100vh; }
    header { background: #141414; border-bottom: 2px solid #e50914; padding: 15px 40px; display: flex; justify-content: space-between; align-items: center; }
    .logo { font-size: 28px; font-weight: 900; letter-spacing: 2px; color: #ffffff; text-decoration: none; }
    .logo span { color: #e50914; }
    nav a { color: #b3b3b3; text-decoration: none; margin-left: 20px; font-weight: 600; }
    nav a:hover { color: #e50914; }
    .container { max-width: 900px; margin: 40px auto; padding: 0 20px; display: flex; gap: 30px; }
    .poster-box img { width: 280px; border-radius: 8px; border: 1px solid #282828; }
    .details-box { display: flex; flex-direction: column; justify-content: center; }
    .title { font-size: 32px; font-weight: bold; margin-bottom: 10px; }
    .genre { color: #e50914; font-weight: bold; margin-bottom: 15px; }
    .overview { color: #ccc; line-height: 1.6; margin-bottom: 25px; }
    .btn-download { background: #e50914; color: white; padding: 12px 24px; text-decoration: none; font-weight: bold; border-radius: 4px; display: inline-block; width: fit-content; }
    .btn-download:hover { background: #b80710; }
    @media (max-width: 600px) { .container { flex-direction: column; align-items: center; text-align: center; } }
  </style>
</head>
<body>

  <header>
    <a href="/" class="logo">ERI<span>VOX</span></a>
    <nav>
      <a href="/">Home</a>
      <a href="/movies">Movies</a>
      <a href="/tvshows">TV Shows</a>
    </nav>
  </header>

  <div class="container">
    <% if (typeof item !== 'undefined') { %>
      <div class="poster-box">
        <img src="<%= item.posterUrl || 'https://via.placeholder.com/280x420?text=No+Poster' %>" alt="<%= item.title %>">
      </div>
      <div class="details-box">
        <h1 class="title"><%= item.title %></h1>
        <% if (item.genre) { %><div class="genre"><%= item.genre %></div><% } %>
        <p class="overview"><%= item.overview || 'No overview available.' %></p>
        <a href="<%= item.gofileUrl %>" target="_blank" class="btn-download">Download / Watch Now</a>
      </div>
    <% } else { %>
      <div style="text-align: center; width: 100%; padding: 40px;">
        <h2>Item not found</h2>
        <a href="/" style="color: #e50914; text-decoration: none; margin-top: 10px; display: inline-block;">Return Home</a>
      </div>
    <% } %>
  </div>

</body>
</html>