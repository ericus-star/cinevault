<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ERIVOX - Home</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', sans-serif; }
    body { background-color: #0b0b0b; color: #ffffff; min-height: 100vh; display: flex; flex-direction: column; }
    header { background: #141414; border-bottom: 2px solid #e50914; padding: 15px 40px; display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; }
    .logo { font-size: 28px; font-weight: 900; letter-spacing: 2px; color: #ffffff; text-decoration: none; }
    .logo span { color: #e50914; }
    .nav-container { display: flex; align-items: center; gap: 20px; }
    nav a { color: #b3b3b3; text-decoration: none; font-weight: 600; }
    nav a:hover, nav a.active { color: #e50914; }
    .search-form { display: flex; align-items: center; }
    .search-input { background: #222; border: 1px solid #333; color: #fff; padding: 8px 12px; border-radius: 4px 0 0 4px; outline: none; font-size: 14px; }
    .search-input:focus { border-color: #e50914; }
    .search-btn { background: #e50914; color: #fff; border: none; padding: 8px 15px; border-radius: 0 4px 4px 0; cursor: pointer; font-weight: bold; }
    .search-btn:hover { background: #b80710; }
    .container { max-width: 1300px; width: 100%; margin: 40px auto; padding: 0 20px; flex-grow: 1; }
    .section-title { font-size: 24px; margin-bottom: 20px; border-left: 4px solid #e50914; padding-left: 10px; }
    .media-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 25px; width: 100%; }
    .media-card { background: #181818; border-radius: 8px; overflow: hidden; border: 1px solid #282828; display: flex; flex-direction: column; transition: transform 0.2s, border-color 0.2s; }
    .media-card:hover { transform: translateY(-5px); border-color: #e50914; }
    .poster { width: 100%; height: 320px; object-fit: cover; background: #222; }
    .card-body { padding: 15px; display: flex; flex-direction: column; flex-grow: 1; }
    .card-title { font-size: 16px; font-weight: bold; margin-bottom: 5px; color: #ffffff; }
    .card-type { font-size: 11px; text-transform: uppercase; color: #888; margin-bottom: 5px; font-weight: bold; }
    .card-genre { font-size: 12px; color: #e50914; margin-bottom: 10px; font-weight: 600; }
    .btn-download { margin-top: auto; background: #e50914; color: white; text-align: center; padding: 10px; text-decoration: none; border-radius: 4px; font-weight: bold; }
    .btn-download:hover { background: #b80710; }
    .btn-sub { background: #222; color: #28a745; text-align: center; padding: 8px; text-decoration: none; border-radius: 4px; font-weight: bold; font-size: 12px; margin-top: 8px; border: 1px solid #28a745; display: block; }
    .btn-sub:hover { background: #28a745; color: white; }
    .btn-delete { width: 100%; background: #222; color: #ff4d4d; border: 1px solid #333; padding: 6px; border-radius: 4px; cursor: pointer; font-size: 11px; font-weight: bold; margin-top: 8px; }
    .btn-delete:hover { background: #ff4d4d; color: white; }
    .no-content { color: #888; text-align: center; grid-column: 1 / -1; padding: 40px; }
    footer { background: #141414; border-top: 1px solid #282828; text-align: center; padding: 20px; margin-top: 40px; color: #777; font-size: 13px; }
    footer a { color: #e50914; text-decoration: none; margin-left: 10px; }
    footer a:hover { text-decoration: underline; }
  </style>
</head>
<body>

  <header>
    <a href="/" class="logo">ERI<span>VOX</span></a>
    
    <div class="nav-container">
      <form action="/" method="GET" class="search-form">
        <input type="text" name="search" placeholder="Search titles..." class="search-input" value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
        <button type="submit" class="search-btn">Search</button>
      </form>

      <nav>
        <a href="/" class="active">Home</a>
        <a href="/movies">Movies</a>
        <a href="/tvshows">TV Shows</a>
        <a href="/admin">Admin Panel</a>
      </nav>
    </div>
  </header>

  <div class="container">
    <h2 class="section-title"><%= typeof searchQuery !== 'undefined' && searchQuery ? 'Search Results for "' + searchQuery + '"' : 'Latest Uploads' %></h2>
    <div class="media-grid">
      <% if (typeof mediaList !== 'undefined' && mediaList.length > 0) { %>
        <% mediaList.forEach(item => { %>
          <div class="media-card">
            <img class="poster" src="<%= item.posterUrl || 'https://via.placeholder.com/200x300?text=No+Poster' %>" alt="<%= item.title %>">
            <div class="card-body">
              <div class="card-type"><%= item.type === 'tv' ? 'TV Show' : 'Movie' %></div>
              <div class="card-title"><%= item.title %></div>
              <% if (item.genre) { %><div class="card-genre"><%= item.genre %></div><% } %>
              
              <a href="<%= item.gofileUrl %>" target="_blank" class="btn-download">Download / Watch</a>

              <% if (item.subtitleUrl && item.subtitleUrl.trim() !== '') { %>
                <a href="<%= item.subtitleUrl %>" target="_blank" class="btn-sub">Download Subtitles</a>
              <% } %>

              <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                <form action="/admin/delete/<%= item._id %>" method="POST">
                  <button type="submit" onclick="return confirm('Delete <%= item.title %>?')" class="btn-delete">Delete Entry</button>
                </form>
              <% } %>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="no-content">No content found.</div>
      <% } %>
    </div>
  </div>

  <footer>
    &copy; <%= new Date().getFullYear() %> ERIVOX. All rights reserved. | <a href="/dmca">DMCA Disclaimer</a>
  </footer>

</body>
</html>