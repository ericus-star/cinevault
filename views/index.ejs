<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ERIVOX - Stream & Download Movies & TV Shows</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    body {
      background-color: #0b0b0b;
      color: #ffffff;
      min-height: 100vh;
    }
    header {
      background: #141414;
      border-bottom: 2px solid #e50914;
      padding: 15px 40px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .logo {
      font-size: 28px;
      font-weight: 900;
      letter-spacing: 2px;
      color: #ffffff;
      text-decoration: none;
    }
    .logo span {
      color: #e50914;
    }
    nav a {
      color: #b3b3b3;
      text-decoration: none;
      margin-left: 20px;
      font-weight: 600;
      transition: color 0.2s;
    }
    nav a:hover, nav a.active {
      color: #e50914;
    }
    .hero {
      text-align: center;
      padding: 100px 20px;
      background: linear-gradient(180deg, rgba(20,20,20,0.8) 0%, rgba(11,11,11,1) 100%);
    }
    .hero h1 {
      font-size: 48px;
      margin-bottom: 15px;
    }
    .hero p {
      color: #aaa;
      font-size: 18px;
      max-width: 600px;
      margin: 0 auto 30px;
    }
    .btn-main {
      background: #e50914;
      color: white;
      padding: 12px 30px;
      text-decoration: none;
      font-weight: bold;
      border-radius: 4px;
      font-size: 16px;
      transition: background 0.2s;
    }
    .btn-main:hover {
      background: #b80710;
    }
  </style>
</head>
<body>

  <header>
    <a href="/" class="logo">ERI<span>VOX</span></a>
    <nav>
      <a href="/" class="active">Home</a>
      <a href="/movies">Movies</a>
      <a href="/tvshows">TV Shows</a>
      <a href="/admin">Admin Panel</a>
    </nav>
  </header>

  <div class="hero">
    <h1>Welcome to ERI<span>VOX</span></h1>
    <p>Your portal for fast, direct media streaming and high-speed downloads.</p>
    <a href="/admin" class="btn-main">Go to Admin Dashboard</a>
  </div>

</body>
</html>