<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CINEVAULT</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="navbar">
    <div class="logo"><h1><a href="/" style="color:white; text-decoration:none;">CINE<span>VAULT</span></a></h1></div>
    <form action="/" method="GET" class="search-form">
      <input type="text" name="search" placeholder="Search..." value="<%= search %>">
      <button type="submit">Search</button>
    </form>
  </header>

  <main class="container">
    <h2 class="section-title">Trending Movies</h2>

    <div class="catalog-grid">
      <% if (catalog && catalog.length > 0) { %>
        <% catalog.forEach(item => { %>
          <div class="card">
            <a href="/movie/<%= item.id %>" style="text-decoration: none;">
              <div class="poster-container">
                <img src="<%= item.poster %>" alt="<%= item.title %>">
              </div>
              <div class="card-info">
                <h3 class="card-title"><%= item.title %></h3>
                <span class="card-year"><%= item.release_date ? item.release_date.split('-')[0] : '' %></span>
              </div>
            </a>
          </div>
        <% }) %>
      <% } else { %>
        <p>No movies found.</p>
      <% } %>
    </div>
  </main>
</body>
</html>