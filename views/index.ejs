<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'ERIVOX - Stream & Download' %></title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        body { background-color: #0f172a; color: #f8fafc; min-height: 100vh; }
        
        .hero { text-align: center; padding: 3rem 1rem 2rem 1rem; background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%); border-bottom: 1px solid #1e293b; }
        .hero h1 { font-size: 2.5rem; font-weight: 800; margin-bottom: 0.5rem; color: #ffffff; }
        .hero p { color: #94a3b8; font-size: 1.1rem; margin-bottom: 1.8rem; }

        .hero-search { max-width: 550px; margin: 0 auto; display: flex; gap: 10px; }
        .hero-search input { flex: 1; padding: 0.8rem 1.2rem; background: #0f172a; border: 1px solid #334155; border-radius: 8px; color: #fff; font-size: 1rem; outline: none; }
        .hero-search input:focus { border-color: #38bdf8; }
        .hero-search button { padding: 0.8rem 1.5rem; background: #0284c7; border: none; border-radius: 8px; color: white; font-weight: 700; cursor: pointer; transition: background 0.2s; }
        .hero-search button:hover { background: #0369a1; }

        .container { max-width: 1200px; margin: 2rem auto; padding: 0 1rem; }
        .section-title { font-size: 1.5rem; font-weight: 700; margin-bottom: 1.5rem; color: #f8fafc; }

        .movie-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 1.5rem; }
        .movie-card { background: #1e293b; border-radius: 10px; overflow: hidden; border: 1px solid #334155; transition: transform 0.2s, border-color 0.2s; text-decoration: none; color: inherit; display: flex; flex-direction: column; }
        .movie-card:hover { transform: translateY(-5px); border-color: #38bdf8; }
        
        .poster-container { width: 100%; aspect-ratio: 2/3; background: #0f172a; position: relative; overflow: hidden; }
        .poster-img { width: 100%; height: 100%; object-fit: cover; }
        
        .card-info { padding: 0.9rem; flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
        .card-title { font-size: 0.95rem; font-weight: 700; margin-bottom: 0.4rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #fff; }
        .card-meta { display: flex; justify-content: space-between; font-size: 0.85rem; color: #38bdf8; font-weight: 600; }
    </style>
</head>
<body>
    <!-- Includes Restored Header & 2-Color Logo -->
    <%- include('partials/navbar') %>

    <!-- Hero Banner -->
    <section class="hero">
        <h1>Stream & Download Free Movies</h1>
        <p>Fast streaming and direct links powered by ERIVOX</p>
        <form action="/search" method="GET" class="hero-search">
            <input type="text" name="q" placeholder="Search by movie title..." required>
            <button type="submit">Search</button>
        </form>
    </section>

    <!-- Movies / TV Grid -->
    <main class="container">
        <h2 class="section-title"><%= typeof title !== 'undefined' ? title : 'Featured Movies' %></h2>
        
        <div class="movie-grid">
            <% if (movies && movies.length > 0) { %>
                <% movies.forEach(movie => { %>
                    <a href="/movie/<%= movie.id %>" class="movie-card">
                        <div class="poster-container">
                            <% if (movie.poster_path) { %>
                                <img src="https://image.tmdb.org/t/p/w500<%= movie.poster_path %>" alt="<%= movie.title || movie.name %>" class="poster-img" loading="lazy">
                            <% } else { %>
                                <div style="display:flex; align-items:center; justify-center; height:100%; color:#64748b; font-size:0.85rem; padding:10px; text-align:center;">No Poster</div>
                            <% } %>
                        </div>
                        <div class="card-info">
                            <div class="card-title"><%= movie.title || movie.name %></div>
                            <div class="card-meta">
                                <span><%= (movie.release_date || movie.first_air_date || '').split('-')[0] || 'N/A' %></span>
                                <span>★ <%= movie.vote_average ? Number(movie.vote_average).toFixed(1) : 'N/A' %></span>
                            </div>
                        </div>
                    </a>
                <% }); %>
            <% } else { %>
                <p style="color: #94a3b8; grid-column: 1/-1;">No movies found. Try searching for another title.</p>
            <% } %>
        </div>
    </main>
</body>
</html>