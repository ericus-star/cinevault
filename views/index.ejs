<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ERIVOX - Stream & Download Movies & TV Shows</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', system-ui, sans-serif; }
    body { background-color: #0d0d0f; color: #ffffff; min-height: 100vh; display: flex; flex-direction: column; }
    
    header { background: #141417; border-bottom: 2px solid #e50914; padding: 20px 40px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; }
    .logo { font-size: 28px; font-weight: 900; letter-spacing: 2px; color: #ffffff; text-decoration: none; }
    .logo span { color: #e50914; }

    nav { display: flex; gap: 20px; align-items: center; }
    nav a { color: #ccc; text-decoration: none; font-weight: bold; font-size: 15px; transition: color 0.2s; }
    nav a:hover { color: #e50914; }

    .search-form { display: flex; gap: 8px; }
    .search-input { background: #1a1a1e; border: 1px solid #333; color: #fff; padding: 8px 14px; border-radius: 6px; outline: none; font-size: 14px; }
    .search-input:focus { border-color: #e50914; }
    .btn-search { background: #e50914; color: #fff; border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-weight: bold; }

    .container { max-width: 1200px; width: 100%; margin: 30px auto; padding: 0 20px; flex-grow: 1; }
    .section-title { font-size: 22px; font-weight: bold; margin-bottom: 20px; border-left: 4px solid #e50914; padding-left: 10px; }

    .media-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 25px; }
    .media-card { background: #151518; border: 1px solid #24242a; border-radius: 10px; overflow: hidden; display: flex; flex-direction: column; transition: transform 0.2s; }
    .media-card:hover { transform: translateY(-5px); border-color: #e50914; }
    
    .poster-container { position: relative; width: 100%; padding-top: 150%; background: #202025; }
    .poster-img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; }
    .badge-type { position: absolute; top: 10px; right: 10px; background: #e50914; color: #fff; font-size: 11px; font-weight: bold; padding: 3px 8px; border-radius: 4px; text-transform: uppercase; }

    .card-body { padding: 15px; display: flex; flex-direction: column; flex-grow: 1; }
    .media-title { font-size: 16px; font-weight: bold; margin-bottom: 6px; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .media-genre { font-size: 12px; color: #888; margin-bottom: 15px; }

    .btn-download { background: #e50914; color: #fff; text-align: center; text-decoration: none; padding: 10px; border-radius: 6px; font-weight: bold; font-size: 13px; margin-top: auto; transition: background 0.2s; }
    .btn-download:hover { background: #b80710; }
    .btn-subtitle { background: #222228; color: #ccc; border: 1px solid #333; margin-top: 6px; }
    .btn-subtitle:hover { background: #33333d; color: #fff; }

    footer { background: #101012; border-top: 1px solid #202025; text-align: center; padding: 20px; color: #666; font-size: 13px; margin-top: 40px; }
    footer a { color: #888; text-decoration: none; margin-left: 10px; }
    footer a:hover { color: #e50914; }
  </style>
</head>
<body>

  <header>
    <a href="/" class="logo">ERI<span>VOX</span></a>
    
    <nav>
      <a href="/">Home</a>
      <a href="/movies">Movies</a>
      <a href="/tvshows">TV Shows</a>
      <% if (isAdmin) { %>
        <a href="/admin" style="color: #28a745;">Admin Panel</a>
      <% } %>
    </nav>

    <form action="/" method="GET" class="search-form">
      <input type="text" name="search" class="search-input" placeholder="Search movies, tv..." value="<%= searchQuery || '' %>">
      <button type="submit" class="btn-search">Search</button>
    </form>
  </header>

  <div class="container">
    <h2 class="section-title">
      <%= searchQuery ? 'Search Results for: "' + searchQuery + '"' : 'Latest Uploads' %>
    </h2>

    <% if (mediaList && mediaList.length > 0) { %>
      <div class="media-grid">
        <% mediaList.forEach(item => { %>
          <div class="media-card">
            <div class="poster-container">
              <img src="<%= item.posterUrl || 'https://via.placeholder.com/300x450?text=No+Poster' %>" alt="<%= item.title %>" class="poster-img" loading="lazy">
              <span class="badge-type"><%= item.type === 'tv' ? 'TV Show' : 'Movie' %></span>
            </div>
            
            <div class="card-body">
              <h3 class="media-title" title="<%= item.title %>"><%= item.title %></h3>
              <p class="media-genre"><%= item.genre || 'Action / Drama' %></p>
              
              <!-- Clean single Gofile download URL resolution -->
              <% 
                let downloadUrl = item.gofileUrl;
                if (!downloadUrl && item.cloudLinks && item.cloudLinks.length > 0) {
                  downloadUrl = item.cloudLinks[0].url;
                }
              %>

              <% if (downloadUrl) { %>
                <a href="<%= downloadUrl %>" target="_blank" rel="noopener noreferrer" class="btn-download">
                  Download (Gofile)
                </a>
              <% } %>

              <% if (item.subtitleUrl) { %>
                <a href="<%= item.subtitleUrl %>" target="_blank" rel="noopener noreferrer" class="btn-download btn-subtitle">
                  Subtitle
                </a>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p style="color: #888; text-align: center; margin-top: 40px;">No media found. Check back later!</p>
    <% } %>
  </div>

  <footer>
    &copy; <%= new Date().getFullYear() %> ERIVOX. All rights reserved. 
    <a href="/dmca">DMCA Disclaimer</a>
  </footer>

</body>
</html>