<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ERIVOX - Home</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; }
    body { background-color: #0d0d0f; color: #ffffff; min-height: 100vh; display: flex; flex-direction: column; }
    
    /* Header & Nav */
    header { background: rgba(20, 20, 20, 0.95); backdrop-filter: blur(10px); border-bottom: 1px solid rgba(229, 9, 20, 0.3); padding: 15px 40px; display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; position: sticky; top: 0; z-index: 100; }
    .logo { font-size: 28px; font-weight: 900; letter-spacing: 2px; color: #ffffff; text-decoration: none; }
    .logo span { color: #e50914; }
    .nav-container { display: flex; align-items: center; gap: 20px; }
    nav a { color: #b3b3b3; text-decoration: none; font-weight: 600; transition: color 0.2s; }
    nav a:hover, nav a.active { color: #e50914; }
    .search-form { display: flex; align-items: center; }
    .search-input { background: #1a1a1e; border: 1px solid #2a2a30; color: #fff; padding: 9px 14px; border-radius: 6px 0 0 6px; outline: none; font-size: 14px; }
    .search-input:focus { border-color: #e50914; }
    .search-btn { background: #e50914; color: #fff; border: none; padding: 9px 18px; border-radius: 0 6px 6px 0; cursor: pointer; font-weight: bold; transition: background 0.2s; }
    .search-btn:hover { background: #b80710; }

    /* Modern Spotlight Hero */
    .spotlight-section { max-width: 1300px; width: 100%; margin: 25px auto 10px; padding: 0 20px; }
    .hero-banner { 
      position: relative; 
      height: 320px; 
      border-radius: 16px; 
      overflow: hidden; 
      background: linear-gradient(90deg, rgba(13,13,15,0.95) 20%, rgba(13,13,15,0.4) 100%), url('https://image.tmdb.org/t/p/original/yDHYTfA3R0jFYba16jBB12RStZ.jpg') center/cover no-repeat;
      display: flex;
      align-items: center;
      padding: 0 40px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }
    .hero-content { max-width: 550px; z-index: 2; }
    .badge { display: inline-block; background: rgba(229, 9, 20, 0.2); color: #e50914; border: 1px solid rgba(229, 9, 20, 0.5); font-size: 11px; font-weight: 800; padding: 4px 10px; border-radius: 20px; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 12px; }
    .hero-title { font-size: 32px; font-weight: 900; line-height: 1.2; margin-bottom: 10px; }
    .hero-desc { font-size: 14px; color: #ccc; margin-bottom: 20px; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

    /* Trending Mini Cards Bar */
    .trending-strip { display: flex; gap: 15px; overflow-x: auto; padding: 15px 5px; margin-top: 20px; scrollbar-width: none; }
    .trending-strip::-webkit-scrollbar { display: none; }
    .strip-card { flex: 0 0 130px; height: 185px; border-radius: 10px; overflow: hidden; position: relative; border: 1px solid #282828; transition: transform 0.3s, border-color 0.3s; cursor: default; }
    .strip-card:hover { transform: translateY(-6px) scale(1.03); border-color: #e50914; }
    .strip-card img { width: 100%; height: 100%; object-fit: cover; }

    /* Media Grid Section */
    .container { max-width: 1300px; width: 100%; margin: 20px auto 40px; padding: 0 20px; flex-grow: 1; }
    .section-title { font-size: 22px; margin-bottom: 20px; border-left: 4px solid #e50914; padding-left: 12px; font-weight: 700; }
    .media-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 25px; width: 100%; }
    .media-card { background: #151518; border-radius: 10px; overflow: hidden; border: 1px solid #24242a; display: flex; flex-direction: column; transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s; }
    .media-card:hover { transform: translateY(-5px); border-color: #e50914; box-shadow: 0 8px 20px rgba(229, 9, 20, 0.15); }
    .poster { width: 100%; height: 310px; object-fit: cover; background: #1e1e24; }
    .card-body { padding: 15px; display: flex; flex-direction: column; flex-grow: 1; }
    .card-title { font-size: 15px; font-weight: 700; margin-bottom: 6px; color: #ffffff; }
    .card-type { font-size: 11px; text-transform: uppercase; color: #888; margin-bottom: 4px; font-weight: 800; }
    .card-genre { font-size: 12px; color: #e50914; margin-bottom: 12px; font-weight: 600; }
    .btn-download { margin-top: auto; background: #e50914; color: white; text-align: center; padding: 10px; text-decoration: none; border-radius: 6px; font-weight: 700; font-size: 13px; transition: background 0.2s; }
    .btn-download:hover { background: #b80710; }
    .btn-sub { background: #1c1c22; color: #28a745; text-align: center; padding: 8px; text-decoration: none; border-radius: 6px; font-weight: 700; font-size: 12px; margin-top: 8px; border: 1px solid rgba(40, 167, 69, 0.4); display: block; }
    .btn-sub:hover { background: #28a745; color: white; }
    .btn-delete { width: 100%; background: #1c1c22; color: #ff4d4d; border: 1px solid #333; padding: 6px; border-radius: 6px; cursor: pointer; font-size: 11px; font-weight: bold; margin-top: 8px; }
    .btn-delete:hover { background: #ff4d4d; color: white; }
    .no-content { color: #888; text-align: center; grid-column: 1 / -1; padding: 40px; }
    
    footer { background: #101012; border-top: 1px solid #202025; text-align: center; padding: 20px; margin-top: 40px; color: #666; font-size: 13px; }
    footer a { color: #e50914; text-decoration: none; margin-left: 10px; }
    footer a:hover { text-decoration: underline; }
  </style>
</head>
<body>

  <header>
    <a href="/" class="logo">ERI<span>VOX</span></a>
    
    <div class="nav-container">
      <form action="/" method="GET" class="search-form">
        <input type="text" name="search" placeholder="Search titles..." class="search-input" value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
        <button type="submit" class="search-btn">Search</button>
      </form>

      <nav>
        <a href="/" class="active">Home</a>
        <a href="/movies">Movies</a>
        <a href="/tvshows">TV Shows</a>
        <a href="/admin">Admin Panel</a>
      </nav>
    </div>
  </header>

  <!-- Modern Hero Showcase -->
  <div class="spotlight-section">
    <div class="hero-banner">
      <div class="hero-content">
        <span class="badge">Featured Spotlight</span>
        <h1 class="hero-title">Deadpool & Wolverine</h1>
        <p class="hero-desc">Wolverine is recovering from his injuries when he crosses paths with the loudmouth Deadpool to defeat a common enemy.</p>
      </div>
    </div>

    <!-- Reliable Horizontal Poster Strip -->
    <div class="trending-strip">
      <div class="strip-card"><img src="https://m.media-amazon.com/images/M/MV5BNzRiMjg0MzUtNTNhRS00M2IzLTlhM2MtMSS5030026362534X_XM._V1_.jpg" alt="Poster"></div>
      <div class="strip-card"><img src="https://m.media-amazon.com/images/M/MV5BNGNhMDIzZTUtNTBlZi00MTRlLWFjM2ItYzViMjE3YzI5MjJhXkEyXkFqcGdeQXVyMTEyMjM2NDc2._V1_.jpg" alt="Poster"></div>
      <div class="strip-card"><img src="https://m.media-amazon.com/images/M/MV5BYzA2Nzk5M2EtMjE5OS00M2JhLTlhM2EtZjU5YjI3MGE0OWUwXkEyXkFqcGdeQXVyMDA4NzMyOA@@._V1_.jpg" alt="Poster"></div>
      <div class="strip-card"><img src="https://m.media-amazon.com/images/M/MV5BMTgxOTY4Mjc3MF5BMl5BanBnXkFtZTcwNTA4MDQyOQ@@._V1_.jpg" alt="Poster"></div>
      <div class="strip-card"><img src="https://m.media-amazon.com/images/M/MV5BMjMyOTM4MDMxNV5BMl5BanBnXkFtZTgwMTMyMDg3NzE@._V1_.jpg" alt="Poster"></div>
      <div class="strip-card"><img src="https://m.media-amazon.com/images/M/MV5BMTczNTI2ODUwOF5BMl5BanBnXkFtZTcwMTU0NTIzMw@@._V1_.jpg" alt="Poster"></div>
      <div class="strip-card"><img src="https://m.media-amazon.com/images/M/MV5BOTEzNWIwMzctOTE1YS00YzA3LWEzZDItM2YwNWUwOWM4YzA1XkEyXkFqcGdeQXVyMTA3MDk2NDg2._V1_.jpg" alt="Poster"></div>
    </div>
  </div>

  <div class="container">
    <h2 class="section-title"><%= typeof searchQuery !== 'undefined' && searchQuery ? 'Search Results for "' + searchQuery + '"' : 'Latest Uploads' %></h2>
    <div class="media-grid">
      <% if (typeof mediaList !== 'undefined' && mediaList.length > 0) { %>
        <% mediaList.forEach(item => { %>
          <div class="media-card">
            <img class="poster" src="<%= item.posterUrl || 'https://via.placeholder.com/200x300?text=No+Poster' %>" alt="<%= item.title %>">
            <div class="card-body">
              <div class="card-type"><%= item.type === 'tv' ? 'TV Show' : 'Movie' %></div>
              <div class="card-title"><%= item.title %></div>
              <% if (item.genre) { %><div class="card-genre"><%= item.genre %></div><% } %>
              
              <a href="<%= item.gofileUrl %>" target="_blank" class="btn-download">Download / Watch</a>

              <% if (item.subtitleUrl && item.subtitleUrl.trim() !== '') { %>
                <a href="<%= item.subtitleUrl %>" target="_blank" class="btn-sub">Download Subtitles</a>
              <% } %>

              <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                <form action="/admin/delete/<%= item._id %>" method="POST">
                  <button type="submit" onclick="return confirm('Delete <%= item.title %>?')" class="btn-delete">Delete Entry</button>
                </form>
              <% } %>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="no-content">No content found.</div>
      <% } %>
    </div>
  </div>

  <footer>
    &copy; <%= new Date().getFullYear() %> ERIVOX. All rights reserved. | <a href="/dmca">DMCA Disclaimer</a>
  </footer>

</body>
</html>