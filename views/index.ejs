<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Erivox - Watch & Download Movies</title>
  <link rel="stylesheet" href="/style.css">
  
  <!-- Security CSS: Disable text & media selection -->
  <style>
    body {
      -webkit-user-select: none; /* Safari */
      -ms-user-select: none; /* IE 10+ */
      user-select: none; /* Standard */
    }
    img, video {
      pointer-events: none; /* Prevent dragging media elements */
    }
  </style>
</head>
<body>

  <!-- Header / Navigation -->
  <header>
    <div class="logo">Erivox</div>
    <nav>
      <a href="/">Home</a>
      <a href="/admin">Admin Panel</a>
    </nav>
  </header>

  <!-- Movie Grid Section -->
  <main class="container">
    <h2>Latest Movies</h2>
    <div class="movie-grid">
      <% if (movies && movies.length > 0) { %>
        <% movies.forEach(movie => { %>
          <div class="movie-card">
            <img src="<%= movie.poster || '/placeholder.jpg' %>" alt="<%= movie.title %>">
            <div class="movie-info">
              <h3><%= movie.title %></h3>
              <p class="genre"><%= movie.genre || 'Action' %></p>
              
              <!-- Clean Download Button (Removed "(Gofile)" tag) -->
              <a href="/movie/<%= movie._id %>" class="btn-download">Download</a>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p>No movies uploaded yet.</p>
      <% } %>
    </div>
  </main>

  <!-- Security Script: Block Inspect Element & DevTools Shortcuts -->
  <script>
    // 1. Disable right-click context menu
    document.addEventListener('contextmenu', (e) => e.preventDefault());

    // 2. Disable keyboard shortcuts for DevTools & Page Source
    document.addEventListener('keydown', (e) => {
      // Prevent F12
      if (e.key === 'F12') {
        e.preventDefault();
      }
      // Prevent Ctrl+Shift+I, Ctrl+Shift+J, Ctrl+Shift+C
      if (e.ctrlKey && e.shiftKey && ['I', 'J', 'C'].includes(e.key.toUpperCase())) {
        e.preventDefault();
      }
      // Prevent Ctrl+U (View Page Source)
      if (e.ctrlKey && e.key.toUpperCase() === 'U') {
        e.preventDefault();
      }
    });
  </script>

</body>
</html>