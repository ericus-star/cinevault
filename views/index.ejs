<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ERIVOX - Home</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', system-ui, sans-serif; }
    body { background-color: #0d0d0f; color: #ffffff; min-height: 100vh; display: flex; flex-direction: column; }
    
    /* Prominent Navigation Header */
    header { 
      background: #141417; 
      border-bottom: 2px solid #e50914; 
      padding: 20px 40px; 
      display: flex; 
      justify-content: space-between; 
      align-items: center; 
      gap: 20px; 
      flex-wrap: wrap; 
      position: sticky; 
      top: 0; 
      z-index: 100; 
      box-shadow: 0 4px 15px rgba(0,0,0,0.5); 
    }
    .logo { font-size: 32px; font-weight: 900; letter-spacing: 2px; color: #ffffff; text-decoration: none; }
    .logo span { color: #e50914; }
    
    .nav-container { display: flex; align-items: center; gap: 25px; flex-wrap: wrap; }
    
    /* Header Links */
    nav { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
    nav a { color: #cccccc; text-decoration: none; font-weight: 800; font-size: 18px; text-transform: uppercase; letter-spacing: 0.5px; transition: color 0.2s, transform 0.2s; }
    nav a:hover, nav a.active { color: #e50914; transform: scale(1.05); }

    /* Genre Dropdown */
    .genre-select { background: #1a1a1e; color: #fff; border: 1px solid #333; padding: 8px 12px; border-radius: 6px; font-weight: 700; font-size: 14px; outline: none; cursor: pointer; }
    .genre-select:focus { border-color: #e50914; }

    /* Search Bar */
    .search-form { display: flex; align-items: center; }
    .search-input { background: #1a1a1e; border: 1px solid #333; color: #fff; padding: 10px 14px; border-radius: 6px 0 0 6px; outline: none; font-size: 15px; width: 220px; }
    .search-input:focus { border-color: #e50914; }
    .search-btn { background: #e50914; color: #fff; border: none; padding: 10px 20px; border-radius: 0 6px 6px 0; cursor: pointer; font-weight: 800; font-size: 14px; transition: background 0.2s; }
    .search-btn:hover { background: #b80710; }

    /* Main Grid Area */
    .container { max-width: 1400px; width: 100%; margin: 30px auto 40px; padding: 0 25px; flex-grow: 1; }
    .section-title { font-size: 24px; margin-bottom: 25px; border-left: 5px solid #e50914; padding-left: 14px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; }
    .media-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 25px; width: 100%; }
    
    .media-card { background: #151518; border-radius: 10px; overflow: hidden; border: 1px solid #24242a; display: flex; flex-direction: column; transition: transform 0.2s, border-color 0.2s; }
    .media-card:hover { transform: translateY(-6px); border-color: #e50914; box-shadow: 0 8px 20px rgba(229, 9, 20, 0.2); }
    .poster { width: 100%; height: 300px; object-fit: cover; background: #1e1e24; }
    .card-body { padding: 15px; display: flex; flex-direction: column; flex-grow: 1; }
    .card-title { font-size: 16px; font-weight: 700; margin-bottom: 6px; color: #ffffff; }
    .card-type { font-size: 11px; text-transform: uppercase; color: #888; margin-bottom: 4px; font-weight: 800; }
    .card-genre { font-size: 12px; color: #e50914; margin-bottom: 12px; font-weight: 700; }
    
    .btn-download { margin-top: auto; background: #e50914; color: white; text-align: center; padding: 10px; text-decoration: none; border-radius: 6px; font-weight: 700; font-size: 13px; }
    .btn-download:hover { background: #b80710; }
    .btn-sub { background: #1c1c22; color: #28a745; text-align: center; padding: 8px; text-decoration: none; border-radius: 6px; font-weight: 700; font-size: 12px; margin-top: 8px; border: 1px solid rgba(40, 167, 69, 0.4); display: block; }
    .btn-sub:hover { background: #28a745; color: white; }
    .btn-delete { width: 100%; background: #1c1c22; color: #ff4d4d; border: 1px solid #333; padding: 6px; border-radius: 6px; cursor: pointer; font-size: 11px; font-weight: bold; margin-top: 8px; }
    .btn-delete:hover { background: #ff4d4d; color: white; }
    .no-content { color: #888; text-align: center; grid-column: 1 / -1; padding: 60px 0; font-size: 18px; }
    
    footer { background: #101012; border-top: 1px solid #202025; text-align: center; padding: 25px; margin-top: 40px; color: #666; font-size: 13px; }
    footer a { color: #e50914; text-decoration: none; margin-left: 10px; font-weight: bold; }
    footer a:hover { text-decoration: underline; }
  </style>
</head>
<body>

  <header>
    <a href="/" class="logo">ERI<span>VOX</span></a>
    
    <div class="nav-container">
      <nav>
        <a href="/" class="active">Home</a>
        <a href="/movies">Movies</a>
        <a href="/tvshows">TV Shows</a>
        
        <!-- Quick Genre Filter -->
        <select class="genre-select" onchange="if (this.value) window.location.href='/?search=' + this.value;">
          <option value="">Genres</option>
          <option value="Action">Action</option>
          <option value="Adventure">Adventure</option>
          <option value="Comedy">Comedy</option>
          <option value="Drama">Drama</option>
          <option value="Horror">Horror</option>
          <option value="Sci-Fi">Sci-Fi</option>
          <option value="Thriller">Thriller</option>
        </select>

        <!-- HIDE ADMIN LINKS UNLESS LOGGED IN -->
        <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
          <a href="/admin" style="color: #28a745;">Admin Panel</a>
          <a href="/logout" style="color: #ff4d4d;">Logout</a>
        <% } %>
      </nav>

      <!-- Search Form -->
      <form action="/" method="GET" class="search-form">
        <input type="text" name="search" placeholder="Search title or genre..." class="search-input" value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
        <button type="submit" class="search-btn">Search</button>
      </form>
    </div>
  </header>

  <div class="container">
    <h2 class="section-title"><%= typeof searchQuery !== 'undefined' && searchQuery ? 'Results for "' + searchQuery + '"' : 'Latest Uploads' %></h2>
    
    <div class="media-grid">
      <% if (typeof mediaList !== 'undefined' && mediaList.length > 0) { %>
        <% mediaList.forEach(item => { %>
          <div class="media-card">
            <img class="poster" src="<%= item.posterUrl || 'https://via.placeholder.com/200x300?text=No+Poster' %>" alt="<%= item.title %>">
            <div class="card-body">
              <div class="card-type"><%= item.type === 'tv' ? 'TV Show' : 'Movie' %></div>
              <div class="card-title"><%= item.title %></div>
              <% if (item.genre) { %><div class="card-genre"><%= item.genre %></div><% } %>
              
              <a href="<%= item.gofileUrl %>" target="_blank" class="btn-download">Download / Watch</a>

              <% if (item.subtitleUrl && item.subtitleUrl.trim() !== '') { %>
                <a href="<%= item.subtitleUrl %>" target="_blank" class="btn-sub">Download Subtitles</a>
              <% } %>

              <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                <form action="/delete/<%= item._id %>" method="POST">
                  <button type="submit" onclick="return confirm('Delete <%= item.title %>?')" class="btn-delete">Delete Entry</button>
                </form>
              <% } %>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="no-content">No content found matching your search.</div>
      <% } %>
    </div>
  </div>

  <footer>
    &copy; <%= new Date().getFullYear() %> ERIVOX. All rights reserved. | <a href="/dmca">DMCA Disclaimer</a>
  </footer>

</body>
</html>