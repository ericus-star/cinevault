<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Erivox - Watch & Download</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    body {
      -webkit-user-select: none;
      -moz-user-select: none;
      -ms-user-select: none;
      user-select: none;
    }
  </style>
</head>
<body>

  <!-- Top Header Navigation -->
  <header>
    <div class="logo">
      <a href="/"><span class="logo-white">ERI</span><span class="logo-red">VOX</span></a>
    </div>
    
    <nav class="top-nav">
      <a href="/" class="<%= activeType === 'all' ? 'active' : '' %>">Home</a>
      <a href="/?type=movie" class="<%= activeType === 'movie' ? 'active' : '' %>">Movies</a>
      <a href="/?type=tv" class="<%= activeType === 'tv' ? 'active' : '' %>">TV Shows</a>
      
      <form action="/" method="GET" style="display: inline-block;">
        <% if (activeType !== 'all') { %><input type="hidden" name="type" value="<%= activeType %>"><% } %>
        <select name="genre" onchange="this.form.submit()" class="nav-genre-select">
          <option value="all" <%= activeGenre === 'all' ? 'selected' : '' %>>Genre</option>
          <option value="Action" <%= activeGenre === 'Action' ? 'selected' : '' %>>Action</option>
          <option value="Comedy" <%= activeGenre === 'Comedy' ? 'selected' : '' %>>Comedy</option>
          <option value="Drama" <%= activeGenre === 'Drama' ? 'selected' : '' %>>Drama</option>
          <option value="Sci-Fi" <%= activeGenre === 'Sci-Fi' ? 'selected' : '' %>>Sci-Fi</option>
          <option value="Horror" <%= activeGenre === 'Horror' ? 'selected' : '' %>>Horror</option>
        </select>
      </form>
    </nav>
  </header>

  <main class="container">
    
    <!-- Centered Search Bar -->
    <div class="search-container" style="margin-bottom: 30px;">
      <form action="/" method="GET" style="display: flex; gap: 10px; width: 100%;">
        <% if (activeType !== 'all') { %><input type="hidden" name="type" value="<%= activeType %>"><% } %>
        <input type="text" name="search" placeholder="Search movies or TV shows..." value="<%= activeSearch %>" style="flex: 1; padding: 12px; background: #1a1a1a; color: white; border: 1px solid #333; border-radius: 4px; font-size: 1rem;">
        <button type="submit" style="padding: 12px 25px; background: #e50914; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold;">Search</button>
      </form>
    </div>

    <h2><%= activeType === 'movie' ? 'Movies' : activeType === 'tv' ? 'TV Shows' : 'Latest Uploads' %></h2>

    <!-- Media Collection Grid -->
    <div class="movie-grid">
      <% if (movies && movies.length > 0) { %>
        <% movies.forEach(movie => { %>
          <div class="movie-card">
            <img src="<%= movie.poster || '/placeholder.jpg' %>" alt="<%= movie.title %>">
            <div class="movie-info">
              <h3><%= movie.title %></h3>
              <p class="genre"><%= movie.genre || 'Action' %></p>
              
              <!-- Navigates to Details/Episode Download Page -->
              <a href="/media/<%= movie._id %>" class="btn-download">
                View / Download
              </a>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p style="color: #888;">No content found.</p>
      <% } %>
    </div>
  </main>

  <!-- Footer with DMCA Disclaimer Button -->
  <footer>
    <div class="footer-container">
      <p>&copy; <%= new Date().getFullYear() %> <span style="color: #ffffff; font-weight: bold;">ERI</span><span style="color: #e50914; font-weight: bold;">VOX</span>. All rights reserved.</p>
      <div style="margin-top: 10px;">
        <a href="/dmca" class="btn-dmca">DMCA Disclaimer</a>
      </div>
    </div>
  </footer>

  <!-- Basic Protection Script -->
  <script>
    document.addEventListener('contextmenu', (e) => e.preventDefault());
    document.addEventListener('keydown', (e) => {
      if (e.key === 'F12') e.preventDefault();
      if (e.ctrlKey && (e.shiftKey && ['I', 'J', 'C'].includes(e.key.toUpperCase())) || e.key.toUpperCase() === 'U') {
        e.preventDefault();
      }
    });
  </script>

</body>
</html>