<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login - CINEVAULT</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        .login-box {
            max-width: 400px;
            margin: 100px auto;
            padding: 30px;
            background: #1f1f1f;
            border-radius: 8px;
            text-align: center;
        }
        .login-box input[type="password"] {
            width: 100%;
            padding: 12px;
            margin: 15px 0;
            border-radius: 4px;
            border: 1px solid #333;
            background: #121212;
            color: #fff;
        }
        .login-box button {
            width: 100%;
            padding: 12px;
            background: #e50914;
            color: white;
            border: none;
            border-radius: 4px;
            font-weight: bold;
            cursor: pointer;
        }
        .error-msg {
            color: #e50914;
            margin-bottom: 10px;
        }
    </style>
</head>
<body>
    <div class="login-box">
        <h2>CINEVAULT Admin Access</h2>
        <% if (typeof error !== 'undefined' && error) { %>
            <p class="error-msg"><%= error %></p>
        <% } %>
        <form action="/admin/login" method="POST">
            <input type="password" name="password" placeholder="Enter Admin Password" required>
            <button type="submit">Login</button>
        </form>
    </div>
</body>
</html>