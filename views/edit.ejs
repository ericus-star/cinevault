<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Media Entry - ERIVOX Admin</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', system-ui, sans-serif; }
    body { background-color: #0d0d0f; color: #ffffff; min-height: 100vh; display: flex; flex-direction: column; }
    
    header { background: #141417; border-bottom: 2px solid #e50914; padding: 20px 40px; display: flex; justify-content: space-between; align-items: center; }
    .logo { font-size: 28px; font-weight: 900; letter-spacing: 2px; color: #ffffff; text-decoration: none; }
    .logo span { color: #e50914; }

    .container { max-width: 800px; width: 100%; margin: 30px auto; padding: 0 20px; flex-grow: 1; }
    .card { background: #151518; border: 1px solid #24242a; border-radius: 10px; padding: 25px; }
    h2 { font-size: 20px; margin-bottom: 18px; border-bottom: 1px solid #2a2a30; padding-bottom: 10px; color: #ffffff; }

    .form-group { margin-bottom: 15px; }
    label { display: block; font-size: 13px; font-weight: bold; margin-bottom: 6px; color: #aaa; text-transform: uppercase; }
    .input-field { width: 100%; background: #1a1a1e; border: 1px solid #333; color: #fff; padding: 10px 14px; border-radius: 6px; outline: none; font-size: 14px; }
    .input-field:focus { border-color: #e50914; }

    .btn { background: #e50914; color: #fff; border: none; padding: 12px 20px; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 14px; width: 100%; transition: background 0.2s; margin-top: 10px; }
    .btn:hover { background: #b80710; }
    .btn-cancel { background: #222228; color: #ccc; text-align: center; display: block; text-decoration: none; padding: 10px; border-radius: 6px; font-weight: bold; font-size: 13px; margin-top: 10px; border: 1px solid #333; }
    .btn-cancel:hover { background: #33333d; }
  </style>
</head>
<body>

  <header>
    <a href="/admin" class="logo">ERI<span>VOX</span> Admin</a>
  </header>

  <div class="container">
    <div class="card">
      <h2>Edit Entry: <%= item.title %></h2>
      <form action="/admin/edit/<%= item._id %>" method="POST">
        
        <div class="form-group">
          <label>Title</label>
          <input type="text" name="title" value="<%= item.title %>" class="input-field" required>
        </div>

        <div class="form-group">
          <label>Type</label>
          <select name="type" class="input-field" required>
            <option value="movie" <%= item.type === 'movie' ? 'selected' : '' %>>Movie</option>
            <option value="tv" <%= item.type === 'tv' ? 'selected' : '' %>>TV Show</option>
          </select>
        </div>

        <div class="form-group">
          <label>Genre</label>
          <input type="text" name="genre" value="<%= item.genre || '' %>" class="input-field">
        </div>

        <div class="form-group">
          <label>Poster URL</label>
          <input type="text" name="posterUrl" value="<%= item.posterUrl || '' %>" class="input-field">
        </div>

        <% 
          let server1 = item.gofileUrl || '';
          let server2 = '';
          let server3 = '';

          if (item.cloudLinks && item.cloudLinks.length > 0) {
            item.cloudLinks.forEach(link => {
              if (link.name === 'Gofile') server1 = link.url;
              if (link.name === 'Mega') server2 = link.url;
              if (link.name === 'Pixeldrain') server3 = link.url;
            });
          }
        %>

        <div class="form-group">
          <label>Server 1 Link (Gofile)</label>
          <input type="url" name="gofileUrl" value="<%= server1 %>" class="input-field" placeholder="https://gofile.io/d/...">
        </div>

        <div class="form-group">
          <label>Server 2 Link (Mega)</label>
          <input type="url" name="megaUrl" value="<%= server2 %>" class="input-field" placeholder="https://mega.nz/file/...">
        </div>

        <div class="form-group">
          <label>Server 3 Link (Pixeldrain / Other)</label>
          <input type="url" name="pixeldrainUrl" value="<%= server3 %>" class="input-field" placeholder="https://pixeldrain.com/u/...">
        </div>

        <div class="form-group">
          <label>Subtitle URL</label>
          <input type="url" name="subtitleUrl" value="<%= item.subtitleUrl || '' %>" class="input-field">
        </div>

        <button type="submit" class="btn">Save & Update Entry</button>
        <a href="/admin" class="btn-cancel">Cancel</a>
      </form>
    </div>
  </div>

</body>
</html>